<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-dialog" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search-bar">
      <span class="search-prompt">~/posts $</span>
      <input type="search" id="search-input" placeholder="输入关键词，比如 虚拟线程 / Kafka / RAG" autocomplete="off" spellcheck="false" aria-label="搜索关键词">
      <kbd>ESC</kbd>
    </div>
    <div class="search-meta" id="search-meta">输入至少一个字符开始检索</div>
    <ul class="search-results" id="search-results"></ul>
    <div class="search-foot"><span>↑↓ 选择</span><span>↵ 打开</span><span>索引：search.json</span></div>
  </div>
</div>
