<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <span class="footer-mark">◈</span>
      <strong><%- config.title %></strong>
      <span class="footer-sub"><%- config.subtitle %></span>
    </div>
    <p class="footer-line"><%- theme.footer.line %></p>
    <p class="footer-copy">© <%- theme.footer.since %>–<%- full_date(new Date(), 'YYYY') %> <%- config.author %> · 代码随便抄，记得注明出处</p>
  </div>
</footer>

<button class="back-to-top" id="back-to-top" type="button" aria-label="回到顶部" title="回到顶部">↑</button>
